# 编译产物
/bin/
*.exe
*.test
*.out

# go build ./cmd/mornlea 的本地产物
/mornlea

# make visual-check / visual-update 默认输出目录（实拍图与差异图，仅调试用）
/build/

# 依赖缓存
/vendor/
/engine/target/

# 编辑器
.DS_Store
.idea/
.vscode/

# 仓库内隔离工作区
/.worktrees/

# GitNexus 本机索引
/.gitnexus/

# 本机 Claude Code 权限配置（可能包含宽泛的 shell 授权）
/.claude/settings.local.json

# 运行时产生的世界存档
/saves/
/worlds/

# 性能剖析产物
*.pprof
cpu.prof
mem.prof

# SDD 工作区（子代理驱动开发的账本与评审包）
/.superpowers/
/gfxspike
/midscene_run/

# 设备确认通道（scripts/agents/confirm）的 Node 工具链产物
**/node_modules/
# 菜单 WebView 前端的 node_modules（dist 不忽略、提交入库）
engine/crates/mornlea_client/frontend/node_modules/
scripts/agents/.npm-cache/
/web/agent-board/dist/
